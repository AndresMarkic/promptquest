; Engine configuration file.
config_version=5

[application]
config/name="PromptQuest"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://assets/icon.png"

[autoload]

SaveData="*res://autoload/SaveData.gd"
Economy="*res://autoload/Economy.gd"
Content="*res://autoload/Content.gd"
Game="*res://autoload/Game.gd"
Audio="*res://autoload/Audio.gd"

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/stretch/scale=1.5

[gui]
theme/custom="res://assets/theme.tres"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_2d=2
